#code[
  #raw("equal =")
  #raw("  fix")
  #raw("    (λeq:Nat→Nat→Bool.")
  #raw("       λm:Nat. λn:Nat.")
  #raw("         if iszero m then iszero n")
  #raw("         else if iszero n then false")
  #raw("         else eq (pred m) (pred n));")
  #raw("▶ equal : Nat → Nat → Bool")
  #raw("plus = fix (λp:Nat→Nat→Nat.")
  #raw("            λm:Nat. λn:Nat.")
  #raw("              if iszero m then n else succ (p (pred m) n));")
  #raw("▶ plus : Nat → Nat → Nat")
  #raw("times = fix (λt:Nat→Nat→Nat.")
  #raw("             λm:Nat. λn:Nat.")
  #raw("               if iszero m then 0 else plus n (t (pred m) n));")
  #raw("▶ times : Nat → Nat → Nat")
  #raw("factorial = fix (λf:Nat→Nat.")
  #raw("                 λm:Nat.")
  #raw("                   if iszero m then 1 else times m (f (pred m)));")
  #raw("▶ factorial : Nat → Nat")
  #raw("factorial 5;")
  #raw("▶ 120 : Nat")
]

