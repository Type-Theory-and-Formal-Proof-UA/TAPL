  #raw("")
  #raw("  Γ ⊢ { ι_i l_i:T_i}^(i in 1..n+k) <: { ι_i l_i:T_i}^(i in 1..n)")
  #raw("                                              (S-RcdWidth)")
  #raw("")
  #raw("  для кожного i   Γ ⊢ S_i <: T_i")
