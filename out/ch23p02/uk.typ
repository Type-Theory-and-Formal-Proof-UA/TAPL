  #raw("загального місця, відбираючи титул предиката в тих умов")
  #raw("належності, які вже не мали розглядатися як такі, що визначають")
  #raw("класи. «Предикативний» таким чином не означав ієрархічного")
  #raw("підходу зокрема чи метафори поступової побудови; це була лише")
  #raw("конкретна пропозиція Рассела й Пуанкаре про те, які умови")
  #raw("належності приймати як класотвірні, або «предикативні». Але")
  #raw("незабаром хвіст почав крутити собакою. Сьогодні предикативна")
  #raw("теорія множин — це конструктивна теорія множин, а непредикативне")
  #raw("означення — це строго те, що пояснено в попередньому абзаці,")
