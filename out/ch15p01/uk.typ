  #raw("      Γ, x:T                 зв’язування змінної терма")
  #raw("")
  #raw("Підтипування                 S <: T")
  #rule([], "S-Refl", [$S <: S$])
  #rule([$S <: U$ #h(1em) $U <: T$], "S-Trans", [$S <: T$])
  #rule([], "S-Top", [$S <: "Top"$])
  #rule([$T_1 <: S_1$ #h(1em) $S_2 <: T_2$], "S-Arrow", [$S_1 -> S_2 <: T_1 -> T_2$])
  #raw("")
